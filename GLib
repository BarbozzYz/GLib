-- 4 cores base (Main, Base, Accent, Font) geram todas as outras
local function deriveTheme(main, base, accent, font)
	local white, black = Color3.new(1, 1, 1), Color3.new(0, 0, 0)
	local h, sat, val = accent:ToHSV()
	local dark = Color3.fromHSV(h, math.min(1, sat * 1.154), val * 0.86)
	return {
		Accent = accent,
		AccentDark = dark,
		AccentStroke = dark:Lerp(black, 0.4),
		Background = main,
		Card = base,
		Field = main:Lerp(base, 0.4),
		Header = base:Lerp(main, 0.09),
		Footer = main:Lerp(base, 0.55),
		Line = base:Lerp(white, 0.07),
		Stroke = base:Lerp(white, 0.149),
		Off = base:Lerp(white, 0.136),
		Text = font,
		Dim = font:Lerp(main, 0.53),
	}
end

