function Card:AddColorPicker(o)
	local win = self.Win
	local color = o.Default or T.Accent
	local h, s, v = color:ToHSV()
	local row = self:_row(o.Name)
	rowLabel(row, o.Name)

	local sw = new("TextButton", {
		Text = "",
		AutoButtonColor = false,
		BackgroundColor3 = Color3.new(1, 1, 1),
		Size = UDim2.fromOffset(30, 20),
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -12, 0.5, 0),
		ZIndex = 3,
		Parent = row,
	}, { corner(4) })
	local swStroke = new("UIStroke", { Color = T.Stroke, Thickness = 1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = sw })
	local swGrad = new("UIGradient", { Rotation = 90, Parent = sw })
	win:_reg(sw)

	local PWID, PHEI = 200, 188
	local pop = new("CanvasGroup", {
		Active = true,
		Visible = false,
		BackgroundColor3 = T.Card,
		GroupTransparency = 1,
		Size = UDim2.fromOffset(PWID, PHEI),
		Parent = win.Overlay,
	}, { corner(10), stroke(T.Line, 1) })
	local popScale = new("UIScale", { Scale = 0.92, Parent = pop })

	local sv = new("Frame", {
		BackgroundColor3 = Color3.fromHSV(h, 1, 1),
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(12, 12),
		Size = UDim2.fromOffset(176, 112),
		Parent = pop,
	}, { corner(6) })
	new("Frame", {
		BackgroundColor3 = Color3.new(1, 1, 1),
		BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1),
		Parent = sv,
	}, { corner(6), new("UIGradient", { Transparency = NumberSequence.new(0, 1) }) })
	new("Frame", {
		BackgroundColor3 = Color3.new(0, 0, 0),
		BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1),
		Parent = sv,
	}, { corner(6), new("UIGradient", { Rotation = 90, Transparency = NumberSequence.new(1, 0) }) })
	local svCur = new("Frame", {
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Size = UDim2.fromOffset(12, 12),
		ZIndex = 5,
		Parent = sv,
	}, { pill(), stroke(Color3.new(1, 1, 1), 2) })

	local hb = new("Frame", {
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(13, 132),
		Size = UDim2.fromOffset(174, 10),
		Parent = pop,
	})
	local hues = {
		Color3.fromRGB(255, 0, 0), Color3.fromRGB(255, 255, 0), Color3.fromRGB(0, 255, 0),
		Color3.fromRGB(0, 255, 255), Color3.fromRGB(0, 0, 255), Color3.fromRGB(255, 0, 255),
		Color3.fromRGB(255, 0, 0),
	}
	for i = 1, 6 do
		new("Frame", {
			BackgroundColor3 = Color3.new(1, 1, 1),
			BorderSizePixel = 0,
			Position = UDim2.fromOffset((i - 1) * 29, 0),
			Size = UDim2.fromOffset(29, 10),
			Parent = hb,
		}, { new("UIGradient", { Color = ColorSequence.new(hues[i], hues[i + 1]) }) })
	end
	local hCur = new("Frame", {
		BackgroundColor3 = Color3.new(1, 1, 1),
		BorderSizePixel = 0,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Size = UDim2.fromOffset(6, 16),
		ZIndex = 5,
		Parent = hb,
	}, { corner(3), stroke(Color3.new(0, 0, 0), 1, 0.5) })

	local prev = new("Frame", {
		BackgroundColor3 = color,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(12, 152),
		Size = UDim2.fromOffset(30, 24),
		Parent = pop,
	}, { corner(5), stroke(T.Stroke, 1) })
	local hexWrap = new("Frame", {
		BackgroundColor3 = T.Field,
		Position = UDim2.fromOffset(50, 152),
		Size = UDim2.fromOffset(138, 24),
		Parent = pop,
	}, { pill(), stroke(T.Stroke, 1) })
	local hex = new("TextBox", {
		BackgroundTransparency = 1,
		Text = "",
		PlaceholderText = "HEX",
		PlaceholderColor3 = T.Dim,
		ClearTextOnFocus = false,
		Font = BOLD,
		TextSize = 12,
		TextColor3 = T.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
		Position = UDim2.fromOffset(12, 0),
		Size = UDim2.new(1, -24, 1, 0),
		Parent = hexWrap,
	})

	local el = { Row = row }
	local popup = {}
	local mode, isOpen, follow, flip, openColor = nil, false, nil, false, color
	local svShown, hShown = Vector2.new(s, 1 - v), h

	local function paint()
		swGrad.Color = ColorSequence.new(color, color:Lerp(Color3.new(0, 0, 0), 0.8))
		prev.BackgroundColor3 = color
		sv.BackgroundColor3 = Color3.fromHSV(h, 1, 1)
		if not hex:IsFocused() then
			hex.Text = string.upper(color:ToHex())
		end
	end
	local function setHSV(nh, ns, nv, silent)
		h, s, v = nh, ns, nv
		color = Color3.fromHSV(h, s, v)
		paint()
		if not silent then
			fire(o.Changed, color)
		end
	end
	local function step(dt)
		local p, sz = sw.AbsolutePosition, sw.AbsoluteSize
		local x = flip and (p.X - PWID - 10) or (p.X + sz.X + 10)
		local y = math.clamp(p.Y - 24, 8, math.max(8, viewport().Y - PHEI - 8))
		pop.Position = UDim2.fromOffset(x, y)
		if mode then
			local m = mousePos()
			if mode == "sv" then
				local ns = math.clamp((m.X - sv.AbsolutePosition.X) / sv.AbsoluteSize.X, 0, 1)
				local nv = 1 - math.clamp((m.Y - sv.AbsolutePosition.Y) / sv.AbsoluteSize.Y, 0, 1)
				setHSV(h, ns, nv)
			else
				local nh = math.clamp((m.X - hb.AbsolutePosition.X) / hb.AbsoluteSize.X, 0, 0.999)
				setHSV(nh, s, v)
			end
		end
		svCur.Position = UDim2.fromScale(s, 1 - v)
		hCur.Position = UDim2.fromScale(h, 0.5)
	end

	function popup.Contains(pt)
		return inside(sw, pt) or (pop.Visible and inside(pop, pt))
	end
	function popup.Close()
		if not isOpen then
			return
		end
		isOpen = false
		mode = nil
		if win._popup == popup then
			win._popup = nil
		end
		if follow then
			follow:Disconnect()
			follow = nil
		end
		tween(pop, 0.18, { GroupTransparency = 1 })
		tween(popScale, 0.18, { Scale = 0.92 })
		tween(swStroke, 0.2, { Color = T.Stroke })
		task.delay(0.2, function()
			if not isOpen then
				pop.Visible = false
			end
		end)
		if color ~= openColor then
			fire(o.Callback, color)
		end
	end
	function popup.Open()
		if isOpen then
			return
		end
		win:_setPopup(popup)
		isOpen = true
		openColor = color
		local p, sz = sw.AbsolutePosition, sw.AbsoluteSize
		flip = p.X + sz.X + 10 + PWID > viewport().X - 8
		svShown, hShown = Vector2.new(s, 1 - v), h
		step(0)
		pop.Visible = true
		tween(pop, 0.25, { GroupTransparency = 0 })
		tween(popScale, 0.3, { Scale = 1 }, Enum.EasingStyle.Back)
		tween(swStroke, 0.2, { Color = T.Accent })
		follow = RunService.RenderStepped:Connect(step)
	end
	sw.MouseButton1Click:Connect(function()
		if isOpen then
			popup.Close()
		else
			popup.Open()
		end
	end)

	local function begin(input, m)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			mode = m
		end
	end
	sv.InputBegan:Connect(function(i)
		begin(i, "sv")
	end)
	hb.InputBegan:Connect(function(i)
		calibrate(hb)
		begin(i, "hue")
	end)
	win:_connect(UIS.InputEnded, function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			mode = nil
		end
	end)
	hex.FocusLost:Connect(function()
		local ok, c = pcall(Color3.fromHex, hex.Text)
		if ok and c then
			local nh, ns, nv = c:ToHSV()
			setHSV(nh, ns, nv)
		else
			paint()
		end
	end)

	function el:Get()
		return color
	end
	function el:Set(c, silent)
		local nh, ns, nv = c:ToHSV()
		svShown, hShown = Vector2.new(ns, 1 - nv), nh
		setHSV(nh, ns, nv, silent)
	end
	paint()
	sw:SetAttribute("GLibNoTheme", true)
	prev:SetAttribute("GLibNoTheme", true)
	sv:SetAttribute("GLibNoTheme", true)
	hb:SetAttribute("GLibNoTheme", true)
	self:_register(o, o.Name, function()
		return string.upper(color:ToHex())
	end, function(hexs)
		local c = Color3.fromHex(hexs)
		el:Set(c)
		fire(o.Callback, c)
	end)
	return el
end

