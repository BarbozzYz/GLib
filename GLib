		LayoutOrder = idx,
		Parent = self.Btns,
	}, { corner(4) })
	win:_reg(sub.Button)
	sub.Button.MouseEnter:Connect(function()
		if self.ActiveSub ~= sub then
			tween(sub.Button, 0.15, { TextColor3 = Color3.fromRGB(200, 200, 200) })
		end
	end)
	sub.Button.MouseLeave:Connect(function()
		if self.ActiveSub ~= sub then
			tween(sub.Button, 0.15, { TextColor3 = T.Dim })
		end
	end)

	sub.Page = new("CanvasGroup", {
		Name = name,
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		Visible = false,
		Parent = win._pages,
	})
	sub.Scroll = new("ScrollingFrame", {
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1),
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollBarThickness = 3,
		ScrollBarImageColor3 = T.Stroke,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		Parent = sub.Page,
	})
	local holder = new("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		Parent = sub.Scroll,
	}, {
		listLayout(14, Enum.FillDirection.Horizontal),
		new("UIPadding", {
			PaddingLeft = UDim.new(0, 14),
			PaddingRight = UDim.new(0, 17),
			PaddingTop = UDim.new(0, 14),
			PaddingBottom = UDim.new(0, 14),
		}),
	})
	local function column(order)
		return new("Frame", {
			BackgroundTransparency = 1,
			Size = UDim2.new(0.5, -7, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			LayoutOrder = order,
			Parent = holder,
		}, { listLayout(12) })
	end
	sub.Left, sub.Right = column(1), column(2)

	table.insert(self.SubTabs, sub)
	sub.Button.MouseButton1Click:Connect(function()
		win:_selectSub(sub)
	end)
	if idx == 1 then
		win:_selectSub(sub, true)
	end
	return sub
end

function Category:AddTab(o)
	if type(o) == "string" then
		o = { Name = o }
	end
	local win = self.Win
	local tab = setmetatable({ Win = win, Name = o.Name, SubTabs = {}, _builtin = o._builtin }, Tab)
