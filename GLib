			ZIndex = 5,
		})
		local cb = buildCheckbox(pv, 20, UDim2.new(1, -14, 1, -24), function(v)
			rotate = v
		end)
		win:_reg(cb.Button)

		local function fit()
			if not model then
				return
			end
			local cf, size = model:GetBoundingBox()
			local dist = (size.Y / 2) / math.tan(math.rad(cam.FieldOfView / 2)) * 1.2 + size.Z
			local cy = cf.Position.Y
			cam.CFrame = CFrame.lookAt(Vector3.new(0, cy, -dist), Vector3.new(0, cy, 0))
		end
		local function refresh()
			if model then
				model:Destroy()
				model = nil
			end
			local char = LocalPlayer.Character
			local m
			if char then
				local old = char.Archivable
				char.Archivable = true
				local ok, c = pcall(function()
					return char:Clone()
				end)
				char.Archivable = old
				if ok then
					m = c
				end
			end
			if not m then
				local ok, c = pcall(function()
					local desc = Players:GetHumanoidDescriptionFromUserId(LocalPlayer.UserId)
					return Players:CreateHumanoidModelFromDescription(desc, Enum.HumanoidRigType.R15)
				end)
				if ok then
					m = c
				end
			end
			if not m then
				return
			end
			for _, d in ipairs(m:GetDescendants()) do
				if d:IsA("BaseScript") or d:IsA("Sound") then
					d:Destroy()
				elseif d:IsA("BasePart") then
					d.Anchored = true
				end
			end
			local hum = m:FindFirstChildOfClass("Humanoid")
			if hum then
				hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
			end
			m.Parent = vpf
			m:PivotTo(CFrame.new(0, 0, 0))
			model = m
			angle = 0
			fit()
		end
		task.spawn(refresh)
		win:_connect(LocalPlayer.CharacterAdded, function()
			task.wait(1)
			refresh()
		end)
		win:_connect(RunService.Heartbeat, function(dt)
			if not model or not root.Visible then
				return
			end
			if rotate then
				angle = (angle + dt * 0.9) % (math.pi * 2)
			elseif angle ~= 0 then
				local a = ((angle + math.pi) % (math.pi * 2)) - math.pi
				a = a * (1 - math.min(1, dt * 6))
				angle = math.abs(a) < 0.002 and 0 or a
			else
				return
			end
			model:PivotTo(CFrame.new(0, 0, 0) * CFrame.Angles(0, angle, 0))
		end)

		win.Preview = {
			Viewport = vpf,
			Refresh = refresh,
			SetRotate = function(_, v)
				cb:Set(v)
			end,
		}
		pv.InputBegan:Connect(function(input)
			win._beginDrag(input)
		end)
	end

	-- drag + resize (com delay suave)
	local dragging, dragOff = false, Vector2.zero
	local resizing, rsStart, rsSize = false, Vector2.zero, Vector2.zero

	function win._beginDrag(input)
		if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then
			return
		end
		local m = mousePos()
		if win._popup and win._popup.Contains(m) then
			return
		end
		if win:_overInteractive(m) then
			return
		end
		dragging = true
		dragOff = m - curPos
	end
	main.InputBegan:Connect(win._beginDrag)
	grip.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			resizing = true
			rsStart = mousePos()
			rsSize = curSize
		end
	end)
	win:_connect(UIS.InputEnded, function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging, resizing = false, false
		end
	end)
	win:_connect(RunService.RenderStepped, function(dt)
		local m = mousePos()
		local v = viewport()
		if dragging then
			local rw = curSize.X + extra
			tgtPos = Vector2.new(math.clamp(m.X - dragOff.X, -rw + 80, v.X - 80), math.clamp(m.Y - dragOff.Y, 0, v.Y - 40))
		end
		if resizing then
			local d = m - rsStart
			tgtSize = Vector2.new(
				math.clamp(rsSize.X + d.X, MINW, math.max(MINW, v.X - 20 - extra)),
				math.clamp(rsSize.Y + d.Y, MINH, math.max(MINH, v.Y - 20))
			)
		end
		local a = 1 - math.exp(-dt * 20)
		local changed = false
		if (tgtPos - curPos).Magnitude > 0.05 then
			curPos = curPos:Lerp(tgtPos, a)
			changed = true
		end
		if (tgtSize - curSize).Magnitude > 0.05 then
			curSize = curSize:Lerp(tgtSize, a)
			changed = true
		end
		if changed then
			root.Position = UDim2.fromOffset(math.floor(curPos.X + 0.5), math.floor(curPos.Y + 0.5))
			root.Size = UDim2.fromOffset(math.floor(curSize.X + 0.5) + extra, math.floor(curSize.Y + 0.5))
		end
	end)

	-- fecha dropdown / colorpicker ao clicar fora
	win:_connect(UIS.InputBegan, function(input, gp)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			if win._popup and not win._popup.Contains(mousePos()) then
				win._popup.Close()
			end
		elseif win.ToggleKey and not gp and input.KeyCode == win.ToggleKey then
			win:Toggle()
		end
	end)

	if opts.Settings ~= false then
		win:_buildSettings()
	end
	local autoName = autoData and Lib:GetAutoload()
	if autoName then
		task.defer(function()
			Lib:Notify({ Text = "Autoload: " .. autoName, Icon = "settings" })
		end)
	end

	return win
end

Lib.Window, Lib.Card = Window, Card

return Lib
