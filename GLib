	local idx = #self.SubTabs + 1
	local sub = setmetatable({ Win = win, Tab = self, Name = name, Index = idx, Cards = {} }, SubTab)

	sub.Button = new("TextButton", {
		Name = name,
		Text = name,
		Font = FONT,
		TextSize = 14,
		TextColor3 = T.Dim,
