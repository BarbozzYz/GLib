local function makeButton(win, parent, o, size, pos, anchor)
	local name = o.Name or o.Text or "Button"
	local btn = new("TextButton", {
		Text = "",
		AutoButtonColor = false,
		BackgroundTransparency = 1,
		AnchorPoint = anchor or Vector2.new(0.5, 0.5),
		Position = pos,
		Size = size,
		ZIndex = 3,
		Parent = parent,
	})
	-- o gradiente fica num Frame separado (UIGradient tambem pintaria o texto)
	local bg = new("Frame", {
		BackgroundColor3 = Color3.new(1, 1, 1),
		BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1),
		Parent = btn,
	}, {
		corner(4),
		stroke(T.AccentStroke, 1),
		new("UIGradient", { Rotation = 90, Color = ColorSequence.new(T.Accent, T.AccentDark) }),
	})
	local shine = new("Frame", {
		BackgroundColor3 = Color3.new(1, 1, 1),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1),
		ZIndex = 2,
		Parent = bg,
	}, { corner(4) })
	new("TextLabel", {
		BackgroundTransparency = 1,
		Text = name,
		Font = BOLD,
		TextSize = o.TextSize or 13,
		TextColor3 = T.Text,
		Size = UDim2.fromScale(1, 1),
		ZIndex = 3,
		Parent = btn,
	})
	local btnIcon = makeIcon(btn, o.Icon, 16, T.Text, UDim2.fromOffset(18, 13))
	if btnIcon then
		btnIcon.Instance.ZIndex = 3
	end
	local sc = new("UIScale", { Parent = btn })
	btn.MouseEnter:Connect(function()
		tween(shine, 0.15, { BackgroundTransparency = 0.88 })
	end)
	btn.MouseLeave:Connect(function()
		tween(shine, 0.15, { BackgroundTransparency = 1 })
	end)
	btn.MouseButton1Down:Connect(function()
		tween(sc, 0.08, { Scale = 0.96 })
	end)
	btn.MouseButton1Up:Connect(function()
		tween(sc, 0.25, { Scale = 1 }, Enum.EasingStyle.Back)
	end)
	btn.MouseButton1Click:Connect(function()
		fire(o.Callback)
	end)
	win:_reg(btn)
	return btn
end

function Card:AddButton(o)
	local name = o.Name or o.Text or "Button"
	local row = self:_row(name, 40)
	local btn = makeButton(self.Win, row, o, UDim2.new(1, -24, 0, 22), UDim2.fromScale(0.5, 0.5))
	return { Row = row, Button = btn }
end

-- varios botoes lado a lado na mesma linha: AddButtonRow({ {Name=..., Callback=...}, {...} })
function Card:AddButtonRow(list)
	local row = self:_row(list[1] and list[1].Name or "Buttons", 40)
	local n = #list
	local gap = 10
	local btns = {}
	for i, o in ipairs(list) do
		local w = 1 / n
		btns[i] = makeButton(
			self.Win,
			row,
			o,
			UDim2.new(w, -(24 + gap * (n - 1)) / n, 0, 22),
			UDim2.new((i - 1) * w, 12 + (i - 1) * gap - (i - 1) * (24 + gap * (n - 1)) / n, 0.5, 0),
			Vector2.new(0, 0.5)
		)
	end
	return { Row = row, Buttons = btns }
end

function Card:AddSlider(o)
	local win = self.Win
	local min, max, inc = o.Min or 0, o.Max or 100, o.Increment or 1
	local suffix = o.Suffix or ""
	local row = self:_row(o.Name, 54)
	rowLabel(row, o.Name, { Position = UDim2.fromOffset(12, 7), Size = UDim2.new(0.6, 0, 0, 18) })
	local valueLabel = label(row, "", 13, BOLD, T.Text, {
		Position = UDim2.new(0, 0, 0, 7),
		Size = UDim2.new(1, -12, 0, 18),
		TextXAlignment = Enum.TextXAlignment.Right,
	})
	local bar = new("Frame", {
		BackgroundColor3 = Color3.fromHex("2C2C2C"),
		BorderSizePixel = 0,
		Position = UDim2.new(0, 12, 0, 37),
		Size = UDim2.new(1, -24, 0, 5),
		Parent = row,
	}, { pill() })
	local fill = new("Frame", {
		BackgroundColor3 = Color3.new(1, 1, 1),
		BorderSizePixel = 0,
		Size = UDim2.fromScale(0, 1),
		Parent = bar,
	}, { pill(), new("UIGradient", { Color = ColorSequence.new(T.AccentDark, T.Accent) }) })
	local knob = new("Frame", {
		BackgroundColor3 = T.Knob,
		BorderSizePixel = 0,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Size = UDim2.fromOffset(28, 12),
		Position = UDim2.new(0, 0, 0.5, 0),
		ZIndex = 3,
		Parent = bar,
	}, { pill() })
	local hit = new("TextButton", {
		Text = "",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(0, 28),
		Size = UDim2.new(1, 0, 0, 26),
		ZIndex = 4,
		Parent = row,
	})
	win:_reg(hit)

	local el = { Row = row }
	local value = math.clamp(o.Default or min, min, max)
	local target = (value - min) / (max - min)
	local shown = target
	local dragging, conn = false, nil

	local function render(a)
		fill.Size = UDim2.new(a, 14 - 28 * a, 1, 0)
		knob.Position = UDim2.new(a, 14 - 28 * a, 0.5, 0)
	end
	local function setValue(a, silent)
		a = math.clamp(a, 0, 1)
		local v = min + a * (max - min)
		v = math.clamp(math.floor(v / inc + 0.5) * inc, min, max)
		v = tonumber(string.format("%.4f", v))
		target = (v - min) / (max - min)
		valueLabel.Text = tostring(v) .. suffix
		if v ~= value then
			value = v
			if not silent then
				fire(o.Callback, v)
			end
		end
	end
	local function loop()
		if conn then
			return
		end
		conn = RunService.RenderStepped:Connect(function(dt)
			if dragging then
				local m = mousePos()
				setValue((m.X - bar.AbsolutePosition.X) / math.max(bar.AbsoluteSize.X, 1))
			end
			shown = shown + (target - shown) * (1 - math.exp(-dt * 14))
			render(shown)
			if not dragging and math.abs(target - shown) < 0.0005 then
				shown = target
				render(shown)
				conn:Disconnect()
				conn = nil
			end
		end)
	end
	hit.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			tween(knob, 0.15, { Size = UDim2.fromOffset(32, 14) })
			loop()
		end
	end)
	win:_connect(UIS.InputEnded, function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then
			dragging = false
			tween(knob, 0.25, { Size = UDim2.fromOffset(28, 12) }, Enum.EasingStyle.Back)
		end
	end)

	valueLabel.Text = tostring(value) .. suffix
	render(shown)
	function el:Get()
		return value
	end
	function el:Set(v, silent)
		setValue((v - min) / (max - min), silent)
		loop()
	end
	self:_register(o, o.Name, function()
		return value
	end, function(v)
		el:Set(tonumber(v) or min)
	end)
	return el
end

