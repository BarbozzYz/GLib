function Window:_connect(signal, fn)
	local c = signal:Connect(fn)
	table.insert(self._conns, c)
	return c
end

function Window:_reg(obj)
	table.insert(self._ui, obj)
	obj.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			calibrate(obj)
		end
	end)
	return obj
end

function Window:_overInteractive(p)
	for _, o in ipairs(self._ui) do
		if o.Parent and realHit(o, p) then
			return true
		end
	end
	return false
end

function Window:_setPopup(p)
	if self._popup and self._popup ~= p then
		self._popup.Close()
	end
	self._popup = p
end

function Window:_closePopup()
	if self._popup then
		self._popup.Close()
	end
end

local function showPage(sub)
	sub.Page.GroupTransparency = 1
	sub.Page.Visible = true
	sub.Scroll.Position = UDim2.fromOffset(0, 12)
	tween(sub.Page, 0.3, { GroupTransparency = 0 })
	tween(sub.Scroll, 0.35, { Position = UDim2.fromOffset(0, 0) })
end

function Window:_selectSub(sub, instant)
	local tab = sub.Tab
	tab.ActiveSub = sub
	for _, s in ipairs(tab.SubTabs) do
		local on = s == sub
		go(s.Button, 0.2, { BackgroundColor3 = on and T.Card or T.Field, TextColor3 = on and T.Text or T.Dim }, instant)
	end
	go(tab.Underline, 0.35, { Position = UDim2.new(0, (sub.Index - 1) * (BTNW + BTNGAP) + BTNW / 2, 1, -3) }, instant)
	if self.ActiveTab == tab then
		for _, s in ipairs(tab.SubTabs) do
			if s ~= sub then
				s.Page.Visible = false
			end
		end
		showPage(sub)
		self:_closePopup()
	end
end

function Window:_selectTab(tab, instant)
	self.ActiveTab = tab
	self:_closePopup()
	for _, t in ipairs(self.Tabs) do
		local on = t == tab
		go(t.Button, 0.2, { BackgroundTransparency = on and 0 or 1 }, instant)
		go(t.Label, 0.2, { TextColor3 = on and T.Text or T.Dim }, instant)
		if t.Icon then
			t.Icon:Color(on and T.Accent or T.Dim, instant)
		end
		t.SubBar.Visible = on
		if not on then
			for _, s in ipairs(t.SubTabs) do
				s.Page.Visible = false
			end
		end
	end
	if tab.ActiveSub then
		showPage(tab.ActiveSub)
	end
end

function Window:_applySearch()
	local q = string.lower(self._query or "")
	for _, tab in ipairs(self.Tabs) do
		for _, sub in ipairs(tab.SubTabs) do
			for _, card in ipairs(sub.Cards) do
				local titleHit = q == "" or string.find(string.lower(card.Title), q, 1, true) ~= nil
				local any, first = false, true
				for _, r in ipairs(card._rows) do
					local hit = titleHit or string.find(string.lower(r.Name), q, 1, true) ~= nil
					r.Row.Visible = hit
					if hit then
						r.Line.Visible = not first
						first = false
						any = true
					end
				end
				card.Frame.Visible = titleHit or any
			end
		end
	end
end

