-- Mesmo sistema de icones da Obsidian (Linoria): modulo Lucide por spritesheet.
-- GetAsset(nome) -> { Url, ImageRectOffset, ImageRectSize }. Carregado sozinho no CreateWindow
-- (executor). Use Icon = "home", "eye", "settings", "crosshair", "lucide:shield" ...
local LUCIDE_URLS = {
	"https://raw.githubusercontent.com/deividcomsono/lucide-roblox-direct/refs/heads/main/source.lua",
	"https://github.com/latte-soft/lucide-roblox/releases/latest/download/lucide-roblox.luau",
}

function Lib:SetIconModule(m)
	self.IconModule = m
end

function Lib:LoadLucide()
	if self.IconModule then
		return true
	end
	local last
	for _, url in ipairs(LUCIDE_URLS) do
		local ok, mod = pcall(function()
			return loadstring(game:HttpGet(url))()
		end)
		if ok and type(mod) == "table" and mod.GetAsset then
			self.IconModule = mod
			return true
		end
		last = mod
	end
	warn("[GLib] Lucide nao carregou (precisa de executor com HttpGet): " .. tostring(last))
	return false
end

-- igual ao Library:GetIcon da Obsidian: retorna { Url, ImageRectOffset, ImageRectSize, Custom }
function Lib:GetIcon(name)
	if type(name) == "number" or tostring(name):match("^%d+$") then
		return { Url = "rbxassetid://" .. tostring(name), ImageRectOffset = Vector2.zero, ImageRectSize = Vector2.zero, Custom = true }
	end
	if self.IconModule then
		local ok, a = pcall(function()
			return self.IconModule.GetAsset((tostring(name):gsub("^lucide:", "")))
		end)
		if ok and a then
			return { Url = a.Url, ImageRectOffset = a.ImageRectOffset, ImageRectSize = a.ImageRectSize, Custom = false }
		end
	end
	return nil
end

-- carrega imagem de URL/arquivo (somente executor: writefile/getcustomasset)
local function loadExternal(img, src)
	task.spawn(function()
		local getasset = getcustomasset or getsynasset
		if not (getasset and isfile and writefile) then
			warn("[GLib] icone externo precisa de getcustomasset/writefile (executor): " .. src)
			return
		end
		local path = src
		if src:match("^https?://") then
			pcall(function()
				if makefolder and not (isfolder and isfolder("glib_icons")) then
					makefolder("glib_icons")
				end
			end)
			path = "glib_icons/" .. (src:gsub("[^%w]", "_")) .. ".png"
			if not isfile(path) then
				local ok, data = pcall(function()
					return game:HttpGet(src)
				end)
				if not ok then
					warn("[GLib] falha ao baixar icone: " .. src)
					return
				end
				writefile(path, data)
			end
		elseif not isfile(path) then
			warn("[GLib] arquivo de icone nao encontrado: " .. src)
			return
		end
		local ok, asset = pcall(getasset, path)
		if ok then
			img.Image = asset
		end
	end)
end

-- aceita: assetid (numero/string), "rbxassetid://..", nome builtin, URL, caminho de arquivo,
-- tabela de spritesheet { Image = id, Offset = Vector2, Size = Vector2 } ou nome em Lib.Icons
local function applyImage(img, icon)
	if type(icon) ~= "table" and Lib.Icons[icon] ~= nil then
		icon = Lib.Icons[icon]
	end
	if type(icon) == "table" then
		img.Image = iconId(icon.Image) or ""
		img.ImageRectOffset = icon.Offset or Vector2.zero
		img.ImageRectSize = icon.Size or Vector2.zero
	elseif type(icon) == "number" or tostring(icon):match("^%d+$") then
		img.Image = "rbxassetid://" .. tostring(icon)
	elseif tostring(icon):match("^rbxasset") or tostring(icon):match("^https?://[%w%.]*roblox%.com") then
		img.Image = tostring(icon)
	else
		loadExternal(img, tostring(icon))
	end
end

local function makeIcon(parent, icon, size, color, pos)
	if icon == nil or icon == "" or icon == 0 then
		return nil
	end
	if type(icon) ~= "table" and Lib.Icons[icon] ~= nil then
		icon = Lib.Icons[icon]
	end
	local holder = new("Frame", {
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = pos,
		Size = UDim2.fromOffset(size, size),
		Parent = parent,
	})
	local setter
	local asset
	if type(icon) == "string" and Lib.IconModule then
		local name = icon:gsub("^lucide:", "")
		local ok, a = pcall(function()
			return Lib.IconModule.GetAsset(name)
		end)
		if ok and a then
			asset = a
		end
	end
	if asset then
		local img = new("ImageLabel", {
			BackgroundTransparency = 1,
			ImageColor3 = color,
			ScaleType = Enum.ScaleType.Fit,
			Size = UDim2.fromScale(1, 1),
			Image = asset.Url or ("rbxassetid://" .. tostring(asset.Id)),
			ImageRectOffset = asset.ImageRectOffset or Vector2.zero,
			ImageRectSize = asset.ImageRectSize or Vector2.zero,
			Parent = holder,
		})
		setter = function(col, instant)
			go(img, 0.2, { ImageColor3 = col }, instant)
		end
	elseif type(icon) == "string" and Builtin[icon] then
		setter = Builtin[icon](holder, size, color)
	else
		local img = new("ImageLabel", {
			BackgroundTransparency = 1,
			ImageColor3 = color,
			ScaleType = Enum.ScaleType.Fit,
			Size = UDim2.fromScale(1, 1),
			Parent = holder,
		})
		applyImage(img, icon)
		setter = function(col, instant)
			go(img, 0.2, { ImageColor3 = col }, instant)
		end
	end
	return {
		Instance = holder,
		Color = function(_, col, instant)
			setter(col, instant)
		end,
	}
end

-- ====================================================================
-- TEMA AO VIVO: recolore tudo que usa as cores do tema (por igualdade de cor)
-- ====================================================================
local ROLES = { "Accent", "AccentDark", "AccentStroke", "Background", "Card", "Field", "Header", "Footer", "Line", "Stroke", "Off", "Text", "Dim" }

local function near(a, b)
	return math.abs(a.R - b.R) < 0.0015 and math.abs(a.G - b.G) < 0.0015 and math.abs(a.B - b.B) < 0.0015
end

local function remap(c, old, new, noText)
	for _, k in ipairs(ROLES) do
		if not (noText and k == "Text") and near(c, old[k]) then
			return new[k]
		end
	end
	return nil
end

local function themeInstance(o, old, new)
	local function set(prop, noText)
		local n = remap(o[prop], old, new, noText)
		if n then
			o[prop] = n
		end
	end
	if o:IsA("GuiObject") then
		set("BackgroundColor3", true)
	end
	if o:IsA("TextLabel") or o:IsA("TextButton") or o:IsA("TextBox") then
		set("TextColor3")
		if o:IsA("TextBox") then
			set("PlaceholderColor3")
		end
	end
	if o:IsA("ImageLabel") or o:IsA("ImageButton") then
		set("ImageColor3")
	end
	if o:IsA("ScrollingFrame") then
		set("ScrollBarImageColor3")
	end
	if o:IsA("UIStroke") then
		set("Color", true)
	end
	if o:IsA("UIGradient") then
		local changed, nk = false, {}
		for i, k in ipairs(o.Color.Keypoints) do
			local n = remap(k.Value, old, new, true)
			changed = changed or n ~= nil
			nk[i] = ColorSequenceKeypoint.new(k.Time, n or k.Value)
		end
		if changed then
			o.Color = ColorSequence.new(nk)
		end
	end
end

local function themeWalk(o, old, new)
	if o:GetAttribute("GLibNoTheme") then
		return
	end
	themeInstance(o, old, new)
	for _, c in ipairs(o:GetChildren()) do
		themeWalk(c, old, new)
	end
end

function Lib:_applyTheme(skipWalk)
	local old = {}
	for k, v in pairs(T) do
		old[k] = v
	end
	local b = self.ThemeBase
	local new = deriveTheme(b.Main, b.Base, b.Accent, b.Font)
	for k, v in pairs(new) do
		T[k] = v
	end
	if not skipWalk and self._gui then
		themeWalk(self._gui, old, T)
	end
end

-- Lib:SetTheme({ Main = Color3, Base = Color3, Accent = Color3, Font = Color3 })
function Lib:SetTheme(t, immediate)
	for k, v in pairs(t) do
		self.ThemeBase[k] = v
	end
	if immediate then
		self:_applyTheme(true)
		return
	end
	if self._themeQueued then
		return
	end
	self._themeQueued = true
	task.defer(function()
		self._themeQueued = false
		self:_applyTheme()
	end)
end

-- ====================================================================
-- ARQUIVOS (config por UserId). Sem filesystem (Studio) usa memoria.
-- ====================================================================
local HttpService = game:GetService("HttpService")
local HAS_FS = type(writefile) == "function" and type(readfile) == "function" and type(isfile) == "function"
	and type(makefolder) == "function" and type(isfolder) == "function" and type(listfiles) == "function"
local MEMFS = {}

local function fsMake(path)
	if HAS_FS and not isfolder(path) then
		pcall(makefolder, path)
	end
end
local function fsWrite(path, data)
	if HAS_FS then
		writefile(path, data)
	else
		MEMFS[path] = data
	end
end
local function fsRead(path)
	if HAS_FS then
		return isfile(path) and readfile(path) or nil
	end
	return MEMFS[path]
end
local function fsList(dir)
	local out = {}
	if HAS_FS then
		local ok, files = pcall(listfiles, dir)
		for _, f in ipairs(ok and files or {}) do
			local n = f:gsub("\\", "/"):match("([^/]+)%.json$")
			if n then
				table.insert(out, n)
			end
		end
	else
		for p in pairs(MEMFS) do
			if p:sub(1, #dir + 1) == dir .. "/" then
				local n = p:match("([^/]+)%.json$")
				if n then
					table.insert(out, n)
				end
			end
		end
	end
	table.sort(out)
	return out
end

local function cfgRoot()
	return "GLib/" .. tostring(LocalPlayer and LocalPlayer.UserId or 0)
end
local function cfgEnsure()
	fsMake("GLib")
	fsMake(cfgRoot())
	fsMake(cfgRoot() .. "/configs")
end
local function cfgClean(name)
	name = tostring(name or ""):gsub("[^%w%s_%-]", "")
	name = name:match("^%s*(.-)%s*$")
	return name ~= "" and name or nil
end
local function readJSON(path)
	local raw = fsRead(path)
	if not raw then
		return nil
	end
	local ok, d = pcall(function()
		return HttpService:JSONDecode(raw)
	end)
	return ok and type(d) == "table" and d or nil
end
local function parseTheme(t)
	local out = {}
	if type(t) == "table" then
		for _, k in ipairs({ "Main", "Base", "Accent", "Font" }) do
			if type(t[k]) == "string" then
				local ok, c = pcall(Color3.fromHex, t[k])
				if ok and c then
					out[k] = c
				end
			end
		end
	end
	return out
end

-- Autoload: nome da config escolhida, guardado por UserId (GLib/<UserId>/autoload.txt)
function Lib:GetAutoload()
	local n = fsRead(cfgRoot() .. "/autoload.txt")
	return n and cfgClean(n) or nil
end

function Lib:_readAutoload()
	local n = self:GetAutoload()
	if not n then
		return nil
	end
	return readJSON(cfgRoot() .. "/configs/" .. n .. ".json"), n
end

-- seta "v": rotacao 180 = "^" (fechado), 0 = "v" (aberto)
local function chevron(parent, color, pos)
	local holder = new("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(10, 6),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = pos,
		Rotation = 180,
		Parent = parent,
	})
	for i, rot in ipairs({ 45, -45 }) do
		new("Frame", {
			BackgroundColor3 = color,
			BorderSizePixel = 0,
			Size = UDim2.fromOffset(6, 1.5),
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromOffset(i == 1 and 3 or 7, 3),
			Rotation = rot,
			Parent = holder,
		})
	end
	return holder
end

-- ====================================================================
-- GUI RAIZ + NOTIFY
-- ====================================================================
local function getGui()
	if Lib._gui and Lib._gui.Parent then
		return Lib._gui
	end
	local gui = Instance.new("ScreenGui")
	gui.Name = "GLib"
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = true
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	gui.DisplayOrder = 999
	pcall(function()
		if gethui then
			gui.Parent = gethui()
		else
			gui.Parent = game:GetService("CoreGui")
		end
	end)
	if not gui.Parent then
		gui.Parent = LocalPlayer:WaitForChild("PlayerGui")
	end
	new("Frame", {
		Name = "Notifications",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -20, 1, -20),
		Size = UDim2.fromOffset(320, 500),
		ZIndex = 200,
		Parent = gui,
	}, {
		new("UIListLayout", {
			Padding = UDim.new(0, 8),
			HorizontalAlignment = Enum.HorizontalAlignment.Right,
			VerticalAlignment = Enum.VerticalAlignment.Bottom,
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})
	Lib._gui = gui
	return gui
end

function Lib:Notify(opts)
	if type(opts) == "string" then
		opts = { Text = opts }
	end
	opts = opts or {}
	local holder = getGui().Notifications
	local dur = opts.Duration or 4
	local slot = new("Frame", { BackgroundTransparency = 1, Size = UDim2.fromOffset(300, 42), Parent = holder })
	local box = new("CanvasGroup", {
		BackgroundColor3 = T.Field,
		GroupTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		Position = UDim2.fromOffset(40, 0),
		Parent = slot,
	}, { pill(), stroke(T.Line, 1) })

	if not makeIcon(box, opts.Icon, 18, T.Accent, UDim2.fromOffset(26, 21)) then
		new("Frame", {
			BackgroundColor3 = T.Accent,
			Size = UDim2.fromOffset(8, 8),
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromOffset(26, 21),
			Parent = box,
		}, { pill() })
	end
	label(box, opts.Text or "Notification", 13, FONT, T.Text, {
		Position = UDim2.fromOffset(52, 5),
		Size = UDim2.new(1, -76, 0, 22),
		TextXAlignment = Enum.TextXAlignment.Center,
		TextTruncate = Enum.TextTruncate.AtEnd,
	})
	local bar = new("Frame", {
		BackgroundColor3 = Color3.fromRGB(200, 200, 200),
		BackgroundTransparency = 0.35,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(52, 31),
		Size = UDim2.new(1, -76, 0, 1),
		Parent = box,
	})

	tween(box, 0.35, { GroupTransparency = 0, Position = UDim2.fromOffset(0, 0) })
	tween(bar, dur, { Size = UDim2.new(0, 0, 0, 1) }, Enum.EasingStyle.Linear)
	task.delay(dur, function()
		tween(box, 0.3, { GroupTransparency = 1, Position = UDim2.fromOffset(40, 0) })
		task.wait(0.35)
		slot:Destroy()
	end)
end

