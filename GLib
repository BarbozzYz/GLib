local function buildToggle(parent, pos, cb)
	local btn = new("TextButton", {
		Text = "",
		AutoButtonColor = false,
		BackgroundColor3 = T.Off,
		Size = UDim2.fromOffset(38, 20),
		AnchorPoint = Vector2.new(1, 0.5),
		Position = pos,
		ZIndex = 3,
		Parent = parent,
	}, { pill() })
	local knob = new("Frame", {
		BackgroundColor3 = T.Knob,
		BorderSizePixel = 0,
		Size = UDim2.fromOffset(14, 14),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0, 10, 0.5, 0),
		Parent = btn,
	}, { pill() })

	local obj = { Button = btn, Value = false }
	function obj:Get()
		return self.Value
	end
	function obj:Set(v, silent, instant)
		v = not not v
		self.Value = v
		local dest = v and UDim2.new(1, -10, 0.5, 0) or UDim2.new(0, 10, 0.5, 0)
		local col = v and T.Accent or T.Off
		if instant then
			knob.Position = dest
			btn.BackgroundColor3 = col
		else
			tween(btn, 0.25, { BackgroundColor3 = col })
			tween(knob, 0.4, { Position = dest }, Enum.EasingStyle.Back)
			tween(knob, 0.12, { Size = UDim2.fromOffset(21, 14) }, Enum.EasingStyle.Quad).Completed:Connect(function()
				tween(knob, 0.3, { Size = UDim2.fromOffset(14, 14) }, Enum.EasingStyle.Back)
			end)
		end
		if not silent then
			fire(cb, v)
		end
	end
	btn.MouseButton1Click:Connect(function()
		obj:Set(not obj.Value)
	end)
	btn.MouseEnter:Connect(function()
		tween(knob, 0.15, { BackgroundColor3 = Color3.new(1, 1, 1) })
	end)
	btn.MouseLeave:Connect(function()
		tween(knob, 0.15, { BackgroundColor3 = T.Knob })
	end)
	return obj
end

local function buildCheckbox(parent, size, pos, cb)
	local btn = new("TextButton", {
		Text = "",
		AutoButtonColor = false,
		BackgroundColor3 = T.Off,
		Size = UDim2.fromOffset(size, size),
		AnchorPoint = Vector2.new(1, 0.5),
		Position = pos,
		ZIndex = 3,
		Parent = parent,
	}, { corner(5) })
	local fill = new("Frame", {
		BackgroundColor3 = T.Accent,
		BorderSizePixel = 0,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(0, 0),
		Parent = btn,
	}, { corner(5) })
	local mark = new("TextLabel", {
		BackgroundTransparency = 1,
		Text = "✓",
		Font = BOLD,
		TextSize = size - 6,
		TextColor3 = T.Text,
		TextTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		ZIndex = 4,
		Parent = btn,
	})
	local scale = new("UIScale", { Scale = 0.3, Parent = mark })

	local obj = { Button = btn, Value = false }
	function obj:Get()
		return self.Value
	end
	function obj:Set(v, silent, instant)
		v = not not v
		self.Value = v
		go(fill, 0.28, { Size = v and UDim2.fromScale(1, 1) or UDim2.fromScale(0, 0) }, instant)
		go(mark, 0.2, { TextTransparency = v and 0 or 1 }, instant)
		go(scale, 0.3, { Scale = v and 1 or 0.3 }, instant, v and Enum.EasingStyle.Back or Enum.EasingStyle.Quint)
		if not silent then
			fire(cb, v)
		end
	end
	btn.MouseButton1Click:Connect(function()
		obj:Set(not obj.Value)
	end)
	btn.MouseEnter:Connect(function()
		if not obj.Value then
			tween(btn, 0.15, { BackgroundColor3 = Color3.fromHex("4A4A4A") })
		end
	end)
	btn.MouseLeave:Connect(function()
		tween(btn, 0.15, { BackgroundColor3 = T.Off })
	end)
	return obj
end

