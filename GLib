function Window:ListConfigs()
	return fsList(cfgRoot() .. "/configs")
end

function Window:SaveConfig(name)
	name = cfgClean(name)
	if not name then
		return false, "Nome invalido"
	end
	cfgEnsure()
	local els = {}
	for flag, f in pairs(self.Flags) do
		local ok, v = pcall(f.Get)
		if ok and v ~= nil then
			els[flag] = v
		end
	end
	local b = Lib.ThemeBase
	local data = {
		Version = 1,
		Elements = els,
		Theme = { Main = b.Main:ToHex(), Base = b.Base:ToHex(), Accent = b.Accent:ToHex(), Font = b.Font:ToHex() },
		MenuBind = self.ToggleKey and self.ToggleKey.Name or "",
	}
	local ok, json = pcall(function()
		return HttpService:JSONEncode(data)
	end)
	if not ok then
		return false, "Erro ao salvar"
	end
	fsWrite(cfgRoot() .. "/configs/" .. name .. ".json", json)
	return true, name
end

function Window:ApplyConfig(data)
	local t = parseTheme(data.Theme)
	if next(t) then
		Lib:SetTheme(t)
		for k, p in pairs(self._themePickers or {}) do
			if t[k] then
				p:Set(t[k], true)
			end
		end
	end
	if data.MenuBind ~= nil then
		local ok, k = pcall(function()
			return data.MenuBind ~= "" and Enum.KeyCode[data.MenuBind] or nil
		end)
		if ok then
			self.ToggleKey = k
			if self._menuBind then
				self._menuBind:Set(k)
			end
		end
	end
	for flag, v in pairs(data.Elements or {}) do
		local f = self.Flags[flag]
		if f then
			pcall(f.Set, v)
		end
	end
end

function Window:LoadConfig(name)
	name = cfgClean(name)
	if not name then
		return false, "Nome invalido"
	end
	local data = readJSON(cfgRoot() .. "/configs/" .. name .. ".json")
	if not data then
		return false, "Config nao encontrada"
	end
	self:ApplyConfig(data)
	return true, name
end

function Window:SetAutoload(name)
	name = cfgClean(name)
	if not name or not readJSON(cfgRoot() .. "/configs/" .. name .. ".json") then
		return false, "Config nao encontrada"
	end
	cfgEnsure()
	fsWrite(cfgRoot() .. "/autoload.txt", name)
	return true, name
end

-- aba Settings embutida (Theme + Configs), sempre por ultimo na sidebar
function Window:_buildSettings()
	local savedOrder, savedCat = self._order, self._lastCat
	self._order = 1000000
	local cat = self:AddCategory("General")
	local tab = cat:AddTab({ Name = "Settings", Icon = "settings", _builtin = true })
	self._order, self._lastCat = savedOrder, savedCat
	self._cats["General"] = nil
	local sub = tab:AddSubTab("Settings")

	local theme = sub:AddCard({ Title = "Theme", Icon = "settings", Enabled = true, NoSave = true, Side = "Left" })
	self._themePickers = {}
	local base = Lib.ThemeBase
	for _, d in ipairs({ { "Main Color", "Main" }, { "Base", "Base" }, { "Accent Color", "Accent" }, { "Font Color", "Font" } }) do
		local key = d[2]
		self._themePickers[key] = theme:AddColorPicker({
			Name = d[1],
			Default = base[key],
			NoSave = true,
			Changed = function(c)
				Lib:SetTheme({ [key] = c })
			end,
		})
	end
	self._menuBind = theme:AddKeybind({
		Name = "Menu Bind",
		Default = self.ToggleKey,
		NoSave = true,
		Changed = function(k)
			self.ToggleKey = k
		end,
	})

	local cfg = sub:AddCard({ Title = "Configs", Icon = "settings", Enabled = true, NoSave = true, Side = "Right" })
	local nameBox = cfg:AddTextBox({ Name = "Config Name", NoSave = true })
	local list = cfg:AddDropdown({ Name = "Config List", Options = { "--" }, Default = "--", NoSave = true })
	local function refresh(select)
		local names = self:ListConfigs()
		if #names == 0 then
			names = { "--" }
		end
		list:Refresh(names, true)
		if select and table.find(names, select) then
			list:Set(select, true)
		end
	end
	local function selected()
		local v = list:Get()
		return v ~= "--" and v or nil
	end
	local function say(text)
		Lib:Notify({ Text = text, Icon = "settings" })
	end
	cfg:AddButtonRow({
		{
			Name = "Create Config",
			Callback = function()
				local ok, res = self:SaveConfig(nameBox:Get())
				if ok then
					refresh(res)
					say("Config criada: " .. res)
				else
					say(res)
				end
			end,
		},
		{
			Name = "Load Config",
			Callback = function()
				local n = selected()
				if not n then
					return say("Selecione uma config")
				end
				local ok, res = self:LoadConfig(n)
				say(ok and ("Config carregada: " .. res) or res)
			end,
		},
	})
	cfg:AddButton({
		Name = "Overwrite Config",
		Callback = function()
			local n = selected()
			if not n then
				return say("Selecione uma config")
			end
			local ok, res = self:SaveConfig(n)
			say(ok and ("Config sobrescrita: " .. res) or res)
		end,
	})
	cfg:AddButton({
		Name = "Set as Autoload",
		Callback = function()
			local n = selected()
			if not n then
				return say("Selecione uma config")
			end
			local ok, res = self:SetAutoload(n)
			say(ok and ("Autoload: " .. res) or res)
		end,
	})
	refresh(Lib:GetAutoload())
end

function Window:SetFooter(left, center, right)
	if left then
		self._fLeft.Text = left
	end
	if center then
		self._fCenter.Text = center
	end
	if right then
		self._fRight.Text = right
	end
end

function Window:Toggle(v)
	if v == nil then
		v = not self.Root.Visible
	end
	self.Root.Visible = v
	self.Overlay.Visible = v
	if not v then
		self:_closePopup()
	end
end

function Window:Notify(o)
	Lib:Notify(o)
end

function Window:Destroy()
	self:_closePopup()
	for _, c in ipairs(self._conns) do
		c:Disconnect()
	end
	self.Root:Destroy()
	self.Overlay:Destroy()
end

