-- ====================================================================
-- HELPERS
-- ====================================================================
local function new(class, props, kids)
	local o = Instance.new(class)
	local parent
	for k, v in pairs(props or {}) do
		if k == "Parent" then
			parent = v
		else
			o[k] = v
		end
	end
	for _, k in ipairs(kids or {}) do
		k.Parent = o
	end
	o.Parent = parent
	return o
end

local function corner(r)
	return new("UICorner", { CornerRadius = UDim.new(0, r) })
end

local function pill()
	return new("UICorner", { CornerRadius = UDim.new(1, 0) })
end

local function stroke(color, thickness, transparency)
	return new("UIStroke", {
		Color = color,
		Thickness = thickness or 1,
		Transparency = transparency or 0,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	})
end

local function listLayout(padding, dir)
	return new("UIListLayout", {
		Padding = UDim.new(0, padding or 0),
		FillDirection = dir or Enum.FillDirection.Vertical,
		SortOrder = Enum.SortOrder.LayoutOrder,
	})
end

local function tween(o, t, props, style, dir)
	local tw = TweenService:Create(o, TweenInfo.new(t, style or Enum.EasingStyle.Quint, dir or Enum.EasingDirection.Out), props)
	tw:Play()
	return tw
end

local function go(o, t, props, instant, style)
	if instant then
		for k, v in pairs(props) do
			o[k] = v
		end
		return
	end
	return tween(o, t, props, style)
end

local function label(parent, text, size, font, color, extra)
	local l = new("TextLabel", {
		BackgroundTransparency = 1,
		Text = text,
		TextSize = size,
		Font = font,
		TextColor3 = color,
		TextXAlignment = Enum.TextXAlignment.Left,
		Size = UDim2.fromScale(1, 1),
		Parent = parent,
	})
	for k, v in pairs(extra or {}) do
		l[k] = v
	end
	return l
end

local function fire(cb, ...)
	if not cb then
		return
	end
	task.spawn(function(...)
		local ok, err = pcall(cb, ...)
		if not ok then
			warn("[GLib] callback: " .. tostring(err))
		end
	end, ...)
end

-- Espaco do mouse: GetMouseLocation inclui a barra superior (inset), mas AbsolutePosition
-- pode nao incluir (depende do executor/ScreenGui). Lib._moff e calibrado sozinho nos primeiros
-- cliques em elementos pequenos, assim o cursor do picker/slider fica EXATO no ponteiro.
Lib._moff = Vector2.zero

local function rawViewport()
	local c = workspace.CurrentCamera
	return c and c.ViewportSize or Vector2.new(1280, 720)
end

local function viewport()
	return rawViewport() + Lib._moff
end

local function mousePos()
	return UIS:GetMouseLocation() + Lib._moff
end

local function calibrate(obj)
	local a, sz = obj.AbsolutePosition, obj.AbsoluteSize
	if sz.Y > 34 or sz.Y <= 0 then
		return
	end
	local raw = UIS:GetMouseLocation()
	local inset = GuiService:GetGuiInset().Y
	if inset <= 0 then
		inset = 36
	end
	for _, oy in ipairs({ 0, -inset, inset }) do
		local y = raw.Y + oy
		if y >= a.Y and y <= a.Y + sz.Y then
			Lib._moff = Vector2.new(0, oy)
			return
		end
	end
end

local function inside(o, p)
	local a, s = o.AbsolutePosition, o.AbsoluteSize
	return p.X >= a.X and p.X <= a.X + s.X and p.Y >= a.Y and p.Y <= a.Y + s.Y
end

local function realHit(o, p)
	if not o.Visible or not inside(o, p) then
		return false
	end
	local a = o.Parent
	while a and a:IsA("GuiObject") do
		if not a.Visible then
			return false
		end
		if (a:IsA("ScrollingFrame") or a.ClipsDescendants) and not inside(a, p) then
			return false
		end
		a = a.Parent
	end
	return true
end

local function iconId(i)
	if i == nil or i == "" or i == 0 then
		return nil
	end
	if type(i) == "number" or tostring(i):match("^%d+$") then
		return "rbxassetid://" .. tostring(i)
	end
	return tostring(i)
end

-- Icones desenhados em codigo (nao dependem de assetid). Uso: Icon = "eye"
local Builtin = {}

Builtin.eye = function(h, s, c)
	local ring = new("Frame", {
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(s, s * 0.62),
		Parent = h,
	}, { pill() })
	local st = stroke(c, 1.6)
	st.Parent = ring
	local dot = new("Frame", {
		BackgroundColor3 = c,
		BorderSizePixel = 0,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(s * 0.3, s * 0.3),
		Parent = h,
	}, { pill() })
	return function(col, instant)
		go(st, 0.2, { Color = col }, instant)
		go(dot, 0.2, { BackgroundColor3 = col }, instant)
	end
end

Builtin.gear = function(h, s, c)
	local parts = {}
	local ring = new("Frame", {
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(s * 0.5, s * 0.5),
		Parent = h,
	}, { pill() })
	local st = stroke(c, 1.6)
	st.Parent = ring
	for i = 0, 7 do
		local a = math.rad(i * 45)
		table.insert(parts, new("Frame", {
			BackgroundColor3 = c,
			BorderSizePixel = 0,
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(0.5, math.sin(a) * s * 0.4, 0.5, -math.cos(a) * s * 0.4),
			Size = UDim2.fromOffset(s * 0.2, s * 0.22),
			Rotation = i * 45,
			Parent = h,
		}))
	end
	return function(col, instant)
		go(st, 0.2, { Color = col }, instant)
		for _, p in ipairs(parts) do
			go(p, 0.2, { BackgroundColor3 = col }, instant)
		end
	end
end

