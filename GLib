function Card:_row(name, height)
	local idx = #self._rows
	local row = new("Frame", {
		Name = name or "Row",
		BackgroundColor3 = Color3.new(1, 1, 1),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Size = UDim2.new(1, 0, 0, height or 36),
		LayoutOrder = idx + 1,
		Parent = self._rowsFrame,
	})
	local line = new("Frame", {
		BackgroundColor3 = T.Line,
		BorderSizePixel = 0,
		Size = UDim2.new(1, 0, 0, 1),
		ZIndex = 2,
		Visible = idx > 0,
		Parent = row,
	})
	table.insert(self._rows, { Row = row, Line = line, Name = name or "" })
	row.MouseEnter:Connect(function()
		tween(row, 0.15, { BackgroundTransparency = 0.965 })
	end)
	row.MouseLeave:Connect(function()
		tween(row, 0.15, { BackgroundTransparency = 1 })
	end)
	return row
end

local function rowLabel(row, text, extra)
	local props = { Position = UDim2.fromOffset(12, 0), Size = UDim2.new(0.6, 0, 1, 0), TextTruncate = Enum.TextTruncate.AtEnd }
	for k, v in pairs(extra or {}) do
		props[k] = v
	end
	return label(row, text or "", 13, BOLD, T.Text, props)
end

function Card:SetEnabled(v, fromToggle, instant)
	v = not not v
	self.Enabled = v
	if not fromToggle then
		self._toggle:Set(v, true, instant)
	end
	go(self._rows_group, 0.25, { GroupTransparency = v and 0 or 0.55 }, instant)
	go(self._hline, 0.25, { BackgroundColor3 = v and T.Accent or T.Line }, instant)
	go(self._title, 0.25, { TextColor3 = v and T.Text or T.Dim }, instant)
	if self._icon then
		self._icon:Color(v and T.Accent or T.Dim, instant)
	end
	self._blocker.Visible = not v
	if not v then
		self.Win:_closePopup()
	end
end

function SubTab:AddCard(o)
	o = o or {}
	local win = self.Win
	local right = o.Side == "Right" or (o.Side == nil and #self.Cards % 2 == 1)
	local card = setmetatable({ Win = win, Title = o.Title or "Card", Enabled = false, _rows = {}, NoSave = o.NoSave }, Card)
	card.Path = tostring(self.Tab.Name) .. "/" .. tostring(self.Name) .. "/" .. card.Title

	local frame = new("Frame", {
		Name = card.Title,
		BackgroundColor3 = T.Card,
		BorderSizePixel = 0,
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		Parent = right and self.Right or self.Left,
	}, { corner(10), stroke(T.Line, 1), listLayout(0) })
	card.Frame = frame

	local header = new("Frame", { Name = "Header", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 46), LayoutOrder = 0, Parent = frame })
	card._icon = makeIcon(header, o.Icon, 22, T.Dim, UDim2.fromOffset(28, 23))
	local hasIcon = card._icon ~= nil
	local tx = hasIcon and 54 or 16
	card._title = label(header, card.Title, 15, BOLD, T.Dim, {
		Position = UDim2.fromOffset(tx, 0),
		Size = UDim2.new(1, -(tx + 70), 1, 0),
		TextTruncate = Enum.TextTruncate.AtEnd,
	})
	card._hline = new("Frame", {
		BackgroundColor3 = T.Line,
		BorderSizePixel = 0,
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.fromScale(0, 1),
		Size = UDim2.new(1, 0, 0, 1),
		Parent = header,
	})
	card._toggle = buildToggle(header, UDim2.new(1, -14, 0.5, 0), function(v)
		card:SetEnabled(v, true)
		fire(o.Callback, v)
	end)
	win:_reg(card._toggle.Button)

	local body = new("Frame", {
		Name = "Body",
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		LayoutOrder = 1,
		Parent = frame,
	})
	card._rows_group = new("CanvasGroup", {
		Name = "Rows",
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		Parent = body,
	}, { corner(10), listLayout(0) })
	card._rowsFrame = card._rows_group
	card._blocker = new("TextButton", {
		Text = "",
		AutoButtonColor = false,
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		ZIndex = 20,
		Parent = body,
	})

	table.insert(self.Cards, card)
	card:SetEnabled(o.Enabled == true, false, true)
	card:_register({}, "__enabled", function()
		return card.Enabled
	end, function(v)
		card:SetEnabled(v)
		fire(o.Callback, v)
	end)
	return card
end

-- registra o elemento para salvar/carregar em config
function Card:_register(o, name, getf, setf)
	if o.NoSave or self.NoSave then
		return
	end
	local win = self.Win
	local flag = o.Flag or (self.Path .. "/" .. tostring(name))
	local n = (win._flagN[flag] or 0) + 1
	win._flagN[flag] = n
	if n > 1 then
		flag = flag .. "#" .. n
	end
	win.Flags[flag] = { Get = getf, Set = setf }
	local auto = win._auto and win._auto.Elements
	if auto and auto[flag] ~= nil then
		local v = auto[flag]
		task.defer(function()
			pcall(setf, v)
		end)
	end
end

