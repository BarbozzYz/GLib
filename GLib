	local bst = new("UIStroke", { Color = T.Stroke, Thickness = 1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = btn })
	local txt = label(btn, "", 12, BOLD, T.Text, {
		Position = UDim2.fromOffset(12, 0),
		Size = UDim2.new(1, -34, 1, 0),
		TextTruncate = Enum.TextTruncate.AtEnd,
	})
	local arrow = chevron(btn, T.Dim, UDim2.new(1, -15, 0.5, 0))
	win:_reg(btn)

	local lst = new("CanvasGroup", {
		Active = true,
		Visible = false,
		BackgroundColor3 = T.Card,
		GroupTransparency = 1,
		Size = UDim2.fromOffset(WB, 0),
		Parent = win.Overlay,
	}, { corner(14), stroke(T.Line, 1) })

	local el = { Row = row, Options = o.Options or {}, Value = o.Default or (o.Options or {})[1] }
	local popup = {}
	local items, fullH = {}, 0
	local isOpen, follow = false, nil

	local function refresh()
		for _, it in ipairs(items) do
			local sel = it.Opt == el.Value
			tween(it.Btn, 0.15, { TextColor3 = sel and T.Accent or T.Text })
			tween(it.Stroke, 0.15, { Color = sel and T.Accent or T.Stroke })
		end
		txt.Text = tostring(el.Value)
	end
	local function build()
		for _, it in ipairs(items) do
			it.Btn:Destroy()
		end
		items = {}
		for i, opt in ipairs(el.Options) do
			local b = new("TextButton", {
				Text = tostring(opt),
				Font = BOLD,
				TextSize = 12,
				TextColor3 = T.Text,
				AutoButtonColor = false,
				BackgroundTransparency = 1,
				Position = UDim2.fromOffset(PAD, PAD + (i - 1) * (ITEM_H + GAP)),
				Size = UDim2.new(1, -PAD * 2, 0, ITEM_H),
				Parent = lst,
			}, { pill() })
			local st = new("UIStroke", { Color = T.Stroke, Thickness = 1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = b })
			b.MouseEnter:Connect(function()
				if opt ~= el.Value then
					tween(st, 0.15, { Color = Color3.fromHex("6A6A6A") })
				end
			end)
			b.MouseLeave:Connect(function()
				if opt ~= el.Value then
					tween(st, 0.15, { Color = T.Stroke })
				end
			end)
			b.MouseButton1Click:Connect(function()
				el:Set(opt)
				popup.Close()
			end)
			items[i] = { Btn = b, Stroke = st, Opt = opt }
		end
		fullH = PAD * 2 + #el.Options * ITEM_H + math.max(#el.Options - 1, 0) * GAP
		refresh()
	end

	local function place()
		local p, s = btn.AbsolutePosition, btn.AbsoluteSize
		lst.Position = UDim2.fromOffset(p.X, p.Y + s.Y + 4)
	end
	function popup.Contains(pt)
		return inside(btn, pt) or (lst.Visible and inside(lst, pt))
	end
	function popup.Close()
		if not isOpen then
			return
		end
		isOpen = false
		if win._popup == popup then
			win._popup = nil
		end
		if follow then
			follow:Disconnect()
			follow = nil
		end
		tween(arrow, 0.25, { Rotation = 180 })
		tween(bst, 0.2, { Color = T.Stroke })
		tween(lst, 0.18, { GroupTransparency = 1, Size = UDim2.fromOffset(WB, 0) })
		task.delay(0.2, function()
			if not isOpen then
				lst.Visible = false
			end
		end)
	end
	function popup.Open()
		if isOpen then
			return
		end
		win:_setPopup(popup)
		isOpen = true
		lst.Size = UDim2.fromOffset(WB, 0)
		lst.GroupTransparency = 1
		place()
		lst.Visible = true
		tween(lst, 0.28, { GroupTransparency = 0, Size = UDim2.fromOffset(WB, fullH) })
		tween(arrow, 0.25, { Rotation = 0 })
		tween(bst, 0.2, { Color = T.Accent })
		follow = RunService.RenderStepped:Connect(place)
	end
	btn.MouseButton1Click:Connect(function()
		if isOpen then
			popup.Close()
		else
			popup.Open()
		end
	end)
	btn.MouseEnter:Connect(function()
		if not isOpen then
			tween(bst, 0.15, { Color = Color3.fromHex("6A6A6A") })
		end
	end)
	btn.MouseLeave:Connect(function()
		if not isOpen then
			tween(bst, 0.15, { Color = T.Stroke })
		end
	end)

	function el:Get()
		return self.Value
	end
	function el:Set(v, silent)
		self.Value = v
		refresh()
		if not silent then
			fire(o.Callback, v)
		end
	end
	function el:Refresh(options, keep)
		self.Options = options
		if not keep or not table.find(options, self.Value) then
			self.Value = options[1]
		end
		build()
	end
	build()
	txt.Text = tostring(el.Value)
	self:_register(o, o.Name, function()
		return el.Value
	end, function(v)
		if table.find(el.Options, v) then
			el:Set(v)
		end
	end)
	return el
end

function Card:AddKeybind(o)
	local win = self.Win
	local row = self:_row(o.Name)
	rowLabel(row, o.Name)
	local btn = new("TextButton", {
		Text = "Key",
		Font = BOLD,
		TextSize = 12,
		TextColor3 = T.Dim,
		AutoButtonColor = false,
		BackgroundColor3 = T.Field,
		Size = UDim2.fromOffset(78, 24),
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -12, 0.5, 0),
		ZIndex = 3,
		Parent = row,
	}, { pill() })
	local st = new("UIStroke", { Color = T.Stroke, Thickness = 1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = btn })
	local sc = new("UIScale", { Parent = btn })
	win:_reg(btn)

	local el = { Row = row, Value = o.Default }
	local waiting, token = false, 0

	local function short(k)
		if not k then
			return "Key"
		end
		local n = k.Name:gsub("^Left", "L")
		n = n:gsub("^Right", "R")
		return n
	end
	local function show()
		btn.Text = short(el.Value)
		btn.TextColor3 = el.Value and T.Text or T.Dim
	end
	local function press(depth)
		tween(sc, 0.08, { Scale = depth }).Completed:Connect(function()
			tween(sc, 0.25, { Scale = 1 }, Enum.EasingStyle.Back)
		end)
	end

	btn.MouseButton1Click:Connect(function()
		if waiting then
			return
		end
		waiting = true
		win._waitKey = true
		token += 1
		local my = token
		press(0.9)
		tween(st, 0.2, { Color = T.Accent })
		btn.TextColor3 = T.Accent
		task.spawn(function()
			local n = 1
			while waiting and token == my do
				btn.Text = string.rep(".", n)
				n = n % 3 + 1
				task.wait(0.7)
			end
		end)
	end)
	btn.MouseEnter:Connect(function()
		if not waiting then
			tween(st, 0.15, { Color = Color3.fromHex("6A6A6A") })
		end
	end)
	btn.MouseLeave:Connect(function()
		if not waiting then
			tween(st, 0.15, { Color = T.Stroke })
		end
	end)

	win:_connect(UIS.InputBegan, function(input, gp)
		if input.UserInputType ~= Enum.UserInputType.Keyboard then
			return
		end
		if waiting then
			waiting = false
			task.defer(function()
				win._waitKey = false
			end)
			token += 1
			if input.KeyCode == Enum.KeyCode.Escape then
				el.Value = nil
			elseif input.KeyCode ~= Enum.KeyCode.Unknown then
				el.Value = input.KeyCode
			end
			tween(st, 0.2, { Color = T.Stroke })
			show()
			press(0.94)
			fire(o.Changed, el.Value)
			return
		end
		if not gp and el.Value and input.KeyCode == el.Value and self.Enabled then
			fire(o.Callback, el.Value)
		end
	end)

	function el:Get()
		return self.Value
	end
	function el:Set(k)
		self.Value = k
		show()
	end
	show()
	self:_register(o, o.Name, function()
		return el.Value and el.Value.Name or ""
	end, function(n)
		local k = (n ~= "" and n) and Enum.KeyCode[n] or nil
		el:Set(k)
		fire(o.Changed, k)
	end)
	return el
end

